# Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Service account JSON as single-line string (for GA4 + GSC; required in production/Vercel)
# Use scripts/env-from-json.ts to convert a .json file to one line
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local dev only: if GOOGLE_SERVICE_ACCOUNT_JSON is unset, load from this file (e.g. root: proximity-learning-ad7b59846f31.json)
# GOOGLE_SERVICE_ACCOUNT_PATH=./proximity-learning-ad7b59846f31.json

# GA4 property ID (e.g. 123456789)
GA4_PROPERTY_ID=

# Search Console site URL (exact property, e.g. https://www.proxlearn.com/)
GSC_SITE_URL=

# Optional: path to CSV for ingest (default: data/Proximity Learning - Blog Articles.csv)
# CSV lives in /data; default filename: "Proximity Learning - Blog Articles.csv"
# BLOG_CSV_PATH=

# Mapbox access token for /map 3D map (get from https://account.mapbox.com/)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
